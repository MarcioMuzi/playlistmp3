# Copie para .env e ajuste se quiser (todas as variáveis são opcionais).

# Porta do app em produção (http://localhost:8080)
APP_PORT=8080

# Versão do yt-dlp: fixa (ex.: 2026.10.26), "latest" ou "nightly".
# Após mudar: docker compose build --no-cache backend && docker compose up -d
YTDLP_VERSION=2026.10.26

# Limite de duração do vídeo, em segundos (7200 = 2h)
MAX_DURATION=7200

# Qualidade do MP3 (kbps, CBR)
AUDIO_BITRATE=320

# Conversões simultâneas
MAX_CONCURRENT_JOBS=2

# Tempo (s) até um MP3 não baixado ser apagado, e intervalo (s) da rotina de limpeza
FILE_TTL=1800
CLEANUP_INTERVAL=300

# Tamanho máximo do diretório temporário em RAM (tmpfs)
TMPFS_SIZE=1g

LOG_LEVEL=INFO

# --- Mitigação de bloqueio do YouTube (PO token) -----------------------------
# Para ativar, descomente as duas linhas abaixo e rode: docker compose up -d
# COMPOSE_PROFILES=pot
# POT_PROVIDER_URL=http://pot-provider:4416
