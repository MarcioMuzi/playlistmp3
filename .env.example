# Copie para .env e ajuste se quiser (todas as variáveis são opcionais).

# Porta do app (http://localhost:8080)
APP_PORT=8080

# Quem pode acessar: 127.0.0.1 = só este computador (padrão, recomendado).
# 0.0.0.0 = qualquer aparelho na mesma rede (ex.: celular no Wi-Fi). Não há
# login nem limite de uso, então só libere em redes de confiança.
# APP_BIND=127.0.0.1

# Versão do yt-dlp: fixa (ex.: 2026.10.26), "latest" ou "nightly".
# Após mudar: docker compose build --no-cache backend && docker compose up -d
YTDLP_VERSION=2026.10.26

# Limite de duração do vídeo, em segundos (7200 = 2h)
MAX_DURATION=7200

# Qualidade do MP3 (kbps, CBR)
AUDIO_BITRATE=320

# Conversões simultâneas
MAX_CONCURRENT_JOBS=2

# Tempo (s) até um MP3 não baixado ser apagado, e intervalo (s) da rotina de limpeza
FILE_TTL=1800
CLEANUP_INTERVAL=300

# Tamanho máximo do diretório temporário em RAM (tmpfs)
TMPFS_SIZE=1g

LOG_LEVEL=INFO

# --- Mitigação de bloqueio do YouTube (PO token) -----------------------------
# Para ativar, descomente as duas linhas abaixo e rode: docker compose up -d
# COMPOSE_PROFILES=pot
# POT_PROVIDER_URL=http://pot-provider:4416

# --- Conta do YouTube (opcional) ----------------------------------------------
# O yt-dlp NÃO aceita login/senha no YouTube: a conta é usada via cookies da
# sessão, exportados do navegador (passo a passo no README, "Conta do YouTube").
# Salve o arquivo em ./secrets/ (pasta fora do Git) e informe só o nome dele.
#
# Modo de uso da conta:
#   fallback = anônimo primeiro; usa a conta só se o YouTube bloquear ou exigir idade
#   always   = usa a conta em todas as conversões (áudio Premium, mais exposição)
#   off      = nunca usa a conta
# Sem o arquivo de cookies, tudo funciona normalmente no modo anônimo.
# YOUTUBE_AUTH_MODE=fallback
# YOUTUBE_COOKIES_FILE=youtube-cookies.txt
